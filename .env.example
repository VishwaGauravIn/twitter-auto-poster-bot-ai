# Google Gemini API Key (Required - Free tier available)
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Niche Profile Selector (Optional - Defaults to 'epfo' if omitted)
# Choices: epfo (Default), ai_tech, crypto, finance, custom
NICHE_PROFILE=epfo

# Optional Twitter API v2 Credentials (Only if not using free Playwright browser automation)
# APP_KEY=your_twitter_api_key
# APP_SECRET=your_twitter_api_secret
# ACCESS_TOKEN=your_access_token
# ACCESS_SECRET=your_access_secret
